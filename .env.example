# ============================================================
# QuantAI 凭证模板
# 1. 复制本文件为 .env （位于项目根目录）
# 2. 填入真实凭证；.env 已被 .gitignore 排除
# 3. 严禁把真实 .env 提交到任何 Git 仓库
# ============================================================

# -------------------- 天勤期货账户 (TqSdk) --------------------
# 在 https://www.shinnytech.com/ 注册快期账户后获取
TQ_ACCOUNT=your_tq_account
TQ_PASSWORD=your_tq_password

# 是否使用模拟账户（True=快期模拟 TqKq；False=实盘 TqAccount）
TQ_USE_SIM=True

# -------------------- 大模型 (OpenAI Compatible) --------------------
# 任何 OpenAI 兼容端点均可（OpenAI / 火山方舟 / 通义 / DeepSeek 等）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-4o-mini

# 可选：金融对话专用模型（多 Agent 时使用）
LLM_MODEL_BOT_FINANCE_ID=
LLM_BASE_BOT_FINANCE_URL=

# -------------------- 钉钉机器人 --------------------
# 在钉钉群「智能机器人 → 自定义」中创建，建议同时开启「加签」与「关键词」校验
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxxxx
DINGTALK_SECRET=SECxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------- 金十数据 Cookie（可选，提高新闻接口稳定性） --------------------
JIN10_COOKIE=

# -------------------- 运行模式 --------------------
# 运行环境：dev / paper / live
QUANTAI_ENV=paper

# 是否启用钉钉通知（False 时仅写日志，便于本地调试）
ENABLE_NOTIFY=True

# 日志等级：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
